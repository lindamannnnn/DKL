            785,
            850,
            833
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "【输入描述】",
        "text_level": 2,
        "bbox": [
            154,
            845,
            267,
            863
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "输入一行，包含两个整数，分别表示一个日期的年、月。",
        "bbox": [
            184,
            876,
            685,
            895
        ],
        "page_idx": 5
    },
    {
        "type": "header",
        "text": "国计算机 GESP",
        "bbox": [
            178,
            65,
            342,
            93
        ],
        "page_idx": 5
    },
    {
        "type": "page_number",
        "text": "6",
        "bbox": [
            836,
            916,
            850,
            926
        ],
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "【输出描述】",
        "text_level": 2,
        "bbox": [
            156,
            114,
            265,
            133
        ],
        "page_idx": 6
    },
    {
        "type": "code",
        "sub_type": "code",
        "code_caption": [],
        "code_body": "```txt\n输出一行，包含一个整数，表示输入月份有多少天。\n【样例输入 1】\n2022 1\n【样例输出 1】\n31\n【样例输入 2】\n2020 2\n【样例输出 2】\n29\n```",
        "bbox": [
            147,
            143,
            645,
            417
        ],
        "page_idx": 6
    },
    {
        "type": "text",
        "text": "【参考程序】",
        "text_level": 2,
        "bbox": [
            156,
            426,
            265,
            447
        ],
        "page_idx": 6
    },
    {
        "type": "code",
        "sub_type": "code",
        "code_caption": [],
        "code_body": "```cpp\n#include <iostream>\nusing namespace std;\nint main() {\n    int y = 0, m = 0;\n    cin >> y >> m;\n    bool leap = false; // 判断闰年\n    if (y % 400 == 0)\n    leap = true;\n    if (y % 4 == 0 && y % 100 != 0)\n    leap = true;\n    if (m == 1 || m == 3 || m == 5 || m == 7 || m == 8 || m == 10 || m == 12)\n    cout << 31 << endl; // 大月\n    else if (m == 4 || m == 6 || m == 9 || m == 11)\n    cout << 30 << endl; // 小月\n    else if (leap)\n    cout << 29 << endl; // 闰年2月\n    else\n    cout << 28 << endl; // 平年2月\n    return 0;\n}\n```",
        "bbox": [
