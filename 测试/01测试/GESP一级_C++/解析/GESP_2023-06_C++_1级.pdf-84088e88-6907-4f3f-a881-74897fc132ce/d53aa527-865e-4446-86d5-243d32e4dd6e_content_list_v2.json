                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "9. 表达式(4 * (11 + 12) / 4)的计算结果为（ ）。A. 47B. 20C. 23D. 56"
                    }
                ]
            },
            "bbox": [
                141,
                511,
