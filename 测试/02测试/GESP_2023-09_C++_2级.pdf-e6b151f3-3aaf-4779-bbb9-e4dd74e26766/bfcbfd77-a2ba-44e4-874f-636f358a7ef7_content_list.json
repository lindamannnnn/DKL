        "page_idx": 9
    },
    {
        "type": "code",
        "sub_type": "code",
        "code_caption": [],
        "code_body": "```cpp\n#include <iostream>\nusing namespace std;\n\nint main() {\n    int n = 0;\n    cin >> n;\n    for (int t = 0; ; t++) {\n    if (n == 495) {\n    cout << t << endl;\n    break;\n    }\n    int m0 = n % 10, m1 = n / 10 % 10, m2 = n / 100;\n    int tmax = 0, tmin = 0;\n    if (m0 >= m1 && m1 >= m2) {\n    tmax = m0 * 100 + m1 * 10 + m2;\n    tmin = m2 * 100 + m1 * 10 + m0;\n    } else if (m0 >= m2 && m2 >= m1) {\n    tmax = m0 * 100 + m2 * 10 + m1;\n    tmin = m1 * 100 + m2 * 10 + m0;\n    } else if (m1 >= m0 && m0 >= m2) {\n    tmax = m1 * 100 + m0 * 10 + m2;\n    tmin = m2 * 100 + m0 * 10 + m1;\n    } else if (m1 >= m2 && m2 >= m0) {\n    tmax = m1 * 100 + m2 * 10 + m0;\n    tmin = m0 * 100 + m2 * 10 + m1;\n    } else if (m2 >= m0 && m0 >= m1) {\n    tmax = m2 * 100 + m0 * 10 + m1;\n    tmin = m1 * 100 + m0 * 10 + m2;\n    } else { // m2 >= m1 && m1 >= m0\n    tmax = m2 * 100 + m1 * 10 + m0;\n    tmin = m0 * 100 + m1 * 10 + m2;\n    }\n    n = tmax - tmin;\n    }\n    return 0;\n}\n```",
