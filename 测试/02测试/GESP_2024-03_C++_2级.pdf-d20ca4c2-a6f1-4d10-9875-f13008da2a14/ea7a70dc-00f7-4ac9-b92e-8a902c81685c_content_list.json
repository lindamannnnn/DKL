        "table_caption": [],
        "table_footnote": [],
        "table_body": "<table><tr><td>1</td><td>|---|</td></tr><tr><td>2</td><td>|xxx|</td></tr><tr><td>3</td><td>|---|</td></tr><tr><td>4</td><td>|xxx|</td></tr><tr><td>5</td><td>|---|</td></tr></table>",
        "bbox": [
            94,
            213,
            186,
            300
        ],
        "page_idx": 7
    },
    {
        "type": "text",
        "text": "请你帮小杨根据给定的 N 打印出对应的“日字矩阵”。",
        "bbox": [
