    {
        "type": "code",
        "sub_type": "code",
        "code_caption": [],
        "code_body": "```txt\ncout << \"请输入卡号：\";\ncin >> N;\norder_num = N / 10; // 获得前5位顺序号，假设录入一定为6位正整数\ncheck_num = N % 10; // 获得最后一位\n\ntnt = 0; // 保存前5位之和\nfor (i = 0; i < 5; i++) {\n    ____;\n    order_num /= 10;\n}\n\nif (____)\n    cout << \"符合校验规则\";\nelse\n    cout << \"不符合校验规则\";\n```",
        "bbox": [
